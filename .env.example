# ─── EnergyLens Environment Configuration ───

# Database (local dev uses Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energylens
DB_USER=energylens
DB_PASSWORD=your_password_here

# ENTSO-E Transparency Platform (free, registration required)
# Register at: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_key_here

# Open-Meteo (free, no key required for basic tier)
# Docs: https://open-meteo.com/en/docs

# Nord Pool (public data, no key required)
# Docs: https://www.nordpoolgroup.com/

# Energi Data Service (free, no key required)
# Docs: https://www.energidataservice.dk/

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CACHE_TTL_MARKET_OPEN=30
CACHE_TTL_MARKET_CLOSED=300

# Streamlit (for local dashboard)
STREAMLIT_SERVER_PORT=8501
