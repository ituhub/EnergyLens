         return count
 
+    def insert_generation(self, records: list[dict]) -> int:
+        """Insert generation records from ENTSO-E."""
+        now = datetime.now(timezone.utc).isoformat()
+        count = 0
+
+        with self.connection() as conn:
+            cur = conn.cursor()
+            placeholder = "%s" if self.use_postgres else "?"
+
+            for record in records:
+                try:
+                    sql = f"""
+                        INSERT INTO generation
+                            (valid_time, knowledge_time, zone, generation_type,
+                             value_mw, is_forecast, source)
+                        VALUES ({', '.join([placeholder] * 7)})
+                    """
+                    # Map area codes back to zone names
+                    area = record.get("area", "")
+                    zone = area  # default
+                    if "10YDK-1" in area:
+                        zone = "DK1"
+                    elif "10YDK-2" in area:
+                        zone = "DK2"
+
+                    cur.execute(sql, (
+                        record.get("timestamp_utc"),
+                        now,
+                        zone,
+                        record.get("generation_type"),
+                        record.get("value_mw"),
+                        1 if record.get("is_forecast", True) else 0,
+                        record.get("source", "entsoe"),
+                    ))
+                    count += 1
+                except Exception as e:
+                    logger.error(f"Generation insert failed: {e}")
+
+            conn.commit()
+
+        logger.info(f"Inserted {count} generation records")
+        return count
+
+    def get_generation_data(self, zone: str, start: str = None, end: str = None) -> list[dict]:
+        """
+        Get generation data for a zone, optionally within a time range.
+        Returns aggregated wind+solar totals per hour for feature engineering.
+        """
+        with self.connection() as conn:
+            cur = conn.cursor()
+            placeholder = "%s" if self.use_postgres else "?"
+
+            sql = f"""
+                SELECT valid_time, generation_type, value_mw, is_forecast
+                FROM generation
+                WHERE zone = {placeholder}
+            """
+            params = [zone]
+
+            if start:
+                sql += f" AND valid_time >= {placeholder}"
+                params.append(start)
+            if end:
+                sql += f" AND valid_time <= {placeholder}"
+                params.append(end)
+
+            sql += " ORDER BY valid_time"
+            cur.execute(sql, params)
+
+            columns = [desc[0] for desc in cur.description]
+            return [dict(zip(columns, row)) for row in cur.fetchall()]
+
