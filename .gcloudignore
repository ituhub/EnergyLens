# .gcloudignore — controls what gcloud uploads to Cloud Build
# UNLIKE .gitignore, we MUST include models/ and data/ for deployment

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# Node (dashboard is built inside Docker, but we need the source)
dashboard/node_modules/
dashboard/dist/

# Git
.git/

# IDE / OS
.vscode/
.github/
.DS_Store
Thumbs.db

# Not needed for deployment
tests/
*.tar.gz
*.md
energylens-dashboard.jsx
